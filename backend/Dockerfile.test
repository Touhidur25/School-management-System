FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /src
COPY . .
RUN dotnet restore SchoolAdmission.Tests/SchoolAdmission.Tests.csproj
RUN dotnet build SchoolAdmission.Tests/SchoolAdmission.Tests.csproj -c Release --no-restore
# TEST_DB_CONNECTION is provided by docker-compose.test.yml
CMD ["dotnet", "test", "SchoolAdmission.Tests/SchoolAdmission.Tests.csproj", "-c", "Release", "--no-build", "--logger", "console;verbosity=normal"]
